    <text:list-item>
     <text:p text:style-name="P46">Extra-Fine Powder</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P46">Raw Leaves</text:p>
    </text:list-item>
    <text:list-item>
     <text:p text:style-name="P46">Dried Leaves</text:p>
    </text:list-item>
