    </draw:frame><text:span text:style-name="T5">Moringa</text:span><text:span text:style-name="T19">: Nature’s Superfood</text:span></text:p>
   <text:p text:style-name="P1"><text:span text:style-name="T19"/></text:p>
   <text:p text:style-name="P42"><text:span text:style-name="T2">Moringa</text:span>: All the good stuff </text:p>
   <text:p text:style-name="P42">with no side effects.</text:p>
   <text:p text:style-name="P42"/>
   <text:p text:style-name="P4"><text:span text:style-name="T2">Moringa</text:span>: More nutritional power than kale, spinish, Swiss Chard, and broccoli.</text:p>
   <text:p text:style-name="P4"/>
