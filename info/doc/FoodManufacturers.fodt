      <text:p text:style-name="P4"><text:bookmark text:name="tw-target-text"/><text:span text:style-name="T16">Food Manufacturers </text:span><text:span text:style-name="T17">for Moringa</text:span><text:span text:style-name="T15"> </text:span></text:p>
      <text:p text:style-name="P5"/>
