     <text:list>
      <text:list-item>
       <text:p text:style-name="P11"><text:span text:style-name="T2">P</text:span><text:span text:style-name="T3">a</text:span><text:span text:style-name="T2">sta Sonoma</text:span><text:span text:style-name="T10">, Rohnert Park:</text:span><text:span text:style-name="T6"> Since 1987, Pasta Sonoma now crafts high-quality pasta for leading retailers, small specialty stores, gift baskets and private label customers. </text:span><text:span text:style-name="T11">C</text:span><text:span text:style-name="T6">onsistently us</text:span><text:span text:style-name="T11">ing</text:span><text:span text:style-name="T6"> only the freshest American-grown wheat, highest grade premium flour, and time-honored Italian production and drying methods. </text:span><text:a xlink:type="simple" xlink:href="https://pastasonoma.com/pages/about-us" text:style-name="Internet_20_link" text:visited-style-name="Visited_20_Internet_20_Link"><text:span text:style-name="T11">About Pasta Sonoma</text:span></text:a>.</text:p>
