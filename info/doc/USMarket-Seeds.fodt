   <table:table table:name="Table1" table:style-name="Table1">
    <table:table-column table:style-name="Table1.A"/>
    <table:table-column table:style-name="Table1.B"/>
    <table:table-row>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="P10"><text:span text:style-name="T2">U</text:span><text:span text:style-name="T1">S Moringa Market 2026 - </text:span><text:span text:style-name="T3">SEEDS</text:span></text:p>
      <text:p text:style-name="P23">米国モリンガ市場 2026年</text:p>
      <text:p text:style-name="P15">Revised January <text:span text:style-name="T47">27</text:span>, 2026 aho</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Table1.A1" office:value-type="string">
      <text:p text:style-name="P11">Green Power <text:span text:style-name="T4">White Paper</text:span></text:p>
